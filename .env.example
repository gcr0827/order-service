# 复制成 .env 后使用：cp .env.example .env
# .env 已被 .gitignore 忽略（含凭据，绝不提交）；本文件只是模板，可以提交

# ── ① Docker Compose 用（MySQL 容器初始化）
MYSQL_ROOT_PASSWORD=change-me-in-your-.env
MYSQL_DATABASE=order_db

# ── ② Go 程序用（应用连接数据库）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me-in-your-.env
DB_DATABASE=order_db
